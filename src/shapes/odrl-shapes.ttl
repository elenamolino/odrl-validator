
@prefix : <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix cc: <http://creativecommons.org/ns#> .


#################################################
# Shape for Policy
#################################################

:PolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Policy ;
    sh:nodeKind sh:IRI ;
    sh:message "Policies must be identified by an IRI." ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Policy may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path [ sh:alternativePath ( odrl:permission odrl:prohibition odrl:obligation ) ] ;
        sh:minCount 1 ;
        sh:message "Policies must have at least one permission, obligation or prohibition." ;
    ] ;

    sh:property [
        sh:path odrl:permission ;
        sh:node :PermissionShape ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :DutyShape ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :ProhibitionShape ;
    ] ;

    sh:property [
        sh:path odrl:profile ;
        sh:nodeKind sh:IRI ;
        sh:message "Profile must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:inheritFrom ;
        sh:nodeKind sh:IRI ;
        sh:message "InheritFrom must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:conflict ;
        sh:nodeKind sh:IRI ;
        sh:in ( odrl:perm odrl:prohibit odrl:invalid ) ;
        sh:maxCount 1 ;
        sh:message "Conflict strategy must appear at most once and be a ConflictTerm: odrl:perm, odrl:prohibit, or odrl:invalid." ;
    ] .


# Set = Policy

:SetPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Set ;
    sh:node :PolicyShape .


# Offer = Rules must have one assigner

:OfferPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Offer ;
    sh:node :PolicyShape ;

    sh:property [
        sh:path odrl:permission ;
        sh:node :OfferPermissionShape ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :OfferProhibitionShape ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :OfferDutyShape ;
    ] .


# Agreement = Rules must have one assigner and one assignee

:AgreementPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Agreement ;
    sh:node :PolicyShape ;

    sh:property [
        sh:path odrl:permission ;
        sh:node :AgreementPermissionShape ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :AgreementProhibitionShape ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :AgreementDutyShape ;
    ] .


#################################################
# Shape for Rule = must have one action
#################################################

:RuleShape a sh:NodeShape ;
    sh:targetClass odrl:Permission, odrl:Prohibition, odrl:Duty ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Rule may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:action ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Rule must have one action." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:action ;
        sh:or (
            [ sh:node :ActionShape ]
            [ sh:node :ActionWithRefinementShape ]
        );
        sh:message "Action should be a supported action or a blank node with rdf:value and odrl:refinement." ;    
    ] ;

    sh:property [
        sh:path odrl:target ;
        sh:maxCount 1 ;
        sh:message "A Rule may have one target." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:target ;
        sh:node :AssetShape ;
        sh:message "Target should be a Asset or AssetCollection." ;
    ] ;

    sh:property [
        sh:path odrl:assignee ;
        sh:maxCount 1 ;
        sh:message "A Rule may have at most one assignee." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:assignee ;
        sh:or (
            [ sh:node :PartyShape ]
            [ sh:node :PartyCollectionShape ]
        ) ;
        sh:message "The assignee should be a Party or PartyCollection." ;
    ] ;

    sh:property [
        sh:path odrl:assigner ;
        sh:maxCount 1 ;
        sh:message "A Rule may have at most one assigner." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:assigner ;
        sh:or (
            [ sh:node :PartyShape ]
            [ sh:node :PartyCollectionShape ]
        ) ;
        sh:message "The assigner should be a Party or PartyCollection." ;
    ] ;

    sh:property [
        sh:path odrl:constraint ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each constraint must conform to ODRL constraint or ODRL logical constraint." ;
    ] .

# Permission = must have one target

:PermissionShape a sh:NodeShape ;
    sh:targetClass odrl:Permission ;
    sh:node :RuleShape ;

    sh:property [
        sh:path odrl:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Permission must have one odrl:target." ;
    ] ;

    sh:property [
        sh:path odrl:duty ;  
        sh:node :DutyShape ;  
        sh:message "Each Permission duty must conform to ODRL duty." ;
    ] .

# Prohibition = must have one target

:ProhibitionShape a sh:NodeShape ;
    sh:targetClass odrl:Prohibition ;
    sh:node :RuleShape ;

    sh:property [
        sh:path odrl:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Prohibition must have one odrl:target." ;
    ] ;

    sh:property [
        sh:path odrl:remedy ;
        sh:node :DutyShape ;
        sh:message "Each Prohibition remedy must conform to ODRL duty." ;
    ] .

# Duty = Rule

:DutyShape a sh:NodeShape ;
    sh:targetClass odrl:Duty ;
    sh:node :RuleShape ;

    sh:property [
        sh:path odrl:consequence ;  
        sh:node :DutyShape ;  
        sh:message "Each Duty consequence must conform to ODRL duty." ;
    ] .

# Rules for offer

:OfferPermissionShape a sh:NodeShape ;
    sh:node :PermissionShape ;
    sh:node :OfferRequiredAssignerShape .

:OfferProhibitionShape a sh:NodeShape ;
    sh:node :ProhibitionShape ;
    sh:node :OfferRequiredAssignerShape .

:OfferDutyShape a sh:NodeShape ;
    sh:node :DutyShape ;
    sh:node :OfferRequiredAssignerShape .

:OfferRequiredAssignerShape a sh:NodeShape ;
    sh:property [
        sh:path odrl:assigner ;
        sh:minCount 1 ;
        sh:message "An Offer rule must have one assigner." ;
    ] .

# Rules for Agreement

:AgreementPermissionShape a sh:NodeShape ;
    sh:node :PermissionShape ;
    sh:node :AgreementRequiredAssignerShape ;
    sh:node :AgreementRequiredAssigneeShape .

:AgreementProhibitionShape a sh:NodeShape ;
    sh:node :ProhibitionShape ;
    sh:node :AgreementRequiredAssignerShape ;
    sh:node :AgreementRequiredAssigneeShape .

:AgreementDutyShape a sh:NodeShape ;
    sh:node :DutyShape ;
    sh:node :AgreementRequiredAssignerShape ;
    sh:node :AgreementRequiredAssigneeShape .

:AgreementRequiredAssignerShape a sh:NodeShape ;
    sh:property [
        sh:path odrl:assigner ;
        sh:minCount 1 ;
        sh:message "An Agreement rule must have one assigner." ;
    ] .

:AgreementRequiredAssigneeShape a sh:NodeShape ;
    sh:property [
        sh:path odrl:assignee ;
        sh:minCount 1 ;
        sh:message "An Agreement rule must have one assignee." ;
    ] .


#################################################
# Shape for Constraint = must have leftOperand, operator and rightOperand or rightOperandReference
#################################################

:ConstraintShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Constraint may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:datatype ;
        sh:maxCount 1 ;
        sh:message "A Constraint may have one dataType." ;
    ] ;

    sh:property [
        sh:path odrl:unit ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Constraint may have one unit, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:status ;
        sh:maxCount 1 ;
        sh:message "A Constraint may have one status." ;
    ] ;

    sh:property [
        sh:path odrl:leftOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Constraint must have one odrl:leftOperand." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:leftOperand ;
        sh:or ([
            sh:in (
                odrl:absolutePosition
                odrl:absoluteSpatialPosition
                odrl:absoluteTemporalPosition
                odrl:absoluteSize
                odrl:count
                odrl:dateTime
                odrl:delayPeriod
                odrl:deliveryChannel
                odrl:elapsedTime
                odrl:event
                odrl:fileFormat
                odrl:industry
                odrl:language
                odrl:media
                odrl:meteredTime
                odrl:payAmount
                odrl:percentage
                odrl:product
                odrl:purpose
                odrl:recipient
                odrl:relativePosition
                odrl:relativeSpatialPosition
                odrl:relativeTemporalPosition
                odrl:relativeSize
                odrl:resolution
                odrl:spatial
                odrl:spatialCoordinates
                odrl:systemDevice
                odrl:timeInterval
                odrl:unitOfCount
                odrl:version
                odrl:virtualLocation
            ) ]
            [ 
                sh:class odrl:LeftOperand;
            ]
        ) ;
        sh:message "The constraint leftOperand should be part of the ODRL vocabulary or typed as odrl:LeftOperand." ;
    ] ;

    sh:property [
        sh:path odrl:operator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Constraint must have one odrl:operator." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:operator ;
        sh:in (
            odrl:eq
            odrl:gt
            odrl:gteq
            odrl:lt
            odrl:lteq
            odrl:neq
            odrl:isA
            odrl:hasPart
            odrl:isPartOf
            odrl:isAllOf
            odrl:isAnyOf
            odrl:isNoneOf
        ) ;
        sh:message "The operator should be a standard ODRL operators." ;
    ] ;

    sh:xone ([ 
        sh:property [
            sh:path odrl:rightOperand ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:or (
                [ sh:nodeKind sh:Literal ]
                [ sh:nodeKind sh:IRI ]
                [ sh:class odrl:RightOperand ]
                [ sh:node :RightOperandListShape ]
            ) ;
            sh:message "A Constraint must have one of odrl:rightOperand or odrl:rightOperandReference." ; 
        ] 
    ][
        sh:property [
            sh:path odrl:rightOperandReference;
            sh:minCount 1 ;
            sh:maxCount 1 ;    
            sh:or (
                [ sh:nodeKind sh:IRI ]
                [ sh:node :RightOperandReferenceListShape ]
            ) ;    
            sh:message "A Constraint must have one of odrl:rightOperand or odrl:rightOperandReference." ; 
        ] 
    ]) .

:RightOperandListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:nodeKind sh:IRI ]
            [ sh:class odrl:RightOperand ]
        ) ;
        sh:message "Each value in rightOperand must be a literal, an IRI, or a RightOperand." ;
    ] .

:RightOperandReferenceListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
        sh:message "Each value in rightOperandReference must be an IRI." ;
    ] .

#################################################
# Logical Constraint = must have one operand
#################################################

:LogicalConstraintShape a sh:NodeShape ;
    sh:targetClass odrl:LogicalConstraint ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Logical Constraint may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path [ sh:alternativePath ( odrl:or odrl:xone odrl:and odrl:andSequence ) ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node :ConstraintListShape ;
        sh:message "A LogicalConstraint must contain one of odrl:and, odrl:or, odrl:xone, or odrl:andSequence." ;
    ] .

:ConstraintListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node :ConstraintShape ;
        sh:message "Each value in a logical constraint must be a Constraint." ;
    ] .


#################################################
# Valid RDF list inspired by shsh:ListShape from SHACL-SHACL
#################################################

:RdfListShape a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdf:rest ] ;
        sh:hasValue rdf:nil ;
        sh:node :RdfListNodeShape ;
    ] .

:RdfListNodeShape a sh:NodeShape ;
    sh:or (
        [
            sh:hasValue rdf:nil ;
            sh:property [
                sh:path rdf:first ;
                sh:maxCount 0 ;
            ] ;
            sh:property [
                sh:path rdf:rest ;
                sh:maxCount 0 ;
            ]
        ]
        [
            sh:not [ sh:hasValue rdf:nil ] ;
            sh:property [
                sh:path rdf:first ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path rdf:rest ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ) .


#################################################
# Shape for Party
#################################################

:PartyTypeShape a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:or (
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue odrl:Party ;
            ]
        ]
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue odrl:PartyCollection ;
            ]
        ]
    ) ;
    sh:message "The party should be typed as odrl:Party or odrl:PartyCollection." .

:PartyShape a sh:NodeShape ;
    sh:node :PartyTypeShape ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Party may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:partOf ;
        sh:node :PartyCollectionShape ;
        sh:message "partOf should point to an PartyCollection." ;
    ] .

:PartyCollectionShape a sh:NodeShape ;
    sh:node :PartyShape ;

    sh:property [
        sh:path odrl:source ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A PartyCollection may have one source, and it must be an IRI." ;
    ] ;
    
    sh:property [
        sh:path odrl:refinement ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each PartyCollection refinement must be a Constraint or LogicalConstraint." ;
    ] .


#################################################
# Shape for Action and Action with refinement
#################################################

:ActionShape a sh:NodeShape ;
    sh:node :AllowedActionValueShape ;

    sh:property [
        sh:path odrl:includedIn ;
        sh:maxCount 1 ;
        sh:in ( odrl:use odrl:transfer ) ;
        sh:message "The value of odrl:includedIn should be either odrl:use or odrl:transfer." ;
    ] ;

    sh:property [
        sh:path odrl:implies ;
        sh:node :AllowedActionValueShape ;
        sh:message "Each implies value should be an Action." ;
    ] .

:AllowedActionValueShape a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:or ([
        sh:in (
            odrl:acceptTracking
            odrl:aggregate
            odrl:anonymize
            odrl:annotate
            odrl:archive
            odrl:attribute
            odrl:compensate
            odrl:concurrentUse
            odrl:delete
            odrl:derive
            odrl:digitize
            odrl:display
            odrl:distribute
            odrl:ensureExclusivity
            odrl:execute
            odrl:extract
            odrl:give
            odrl:grantUse
            odrl:include
            odrl:index
            odrl:inform
            odrl:install
            odrl:modify
            odrl:move
            odrl:nextPolicy
            odrl:obtainConsent
            odrl:play
            odrl:present
            odrl:print
            odrl:read
            odrl:reproduce
            odrl:reviewPolicy
            odrl:sell
            odrl:stream
            odrl:synchronize
            odrl:textToSpeech
            odrl:transfer
            odrl:transform
            odrl:translate
            odrl:uninstall
            odrl:use
            odrl:watermark
            cc:Attribution
            cc:CommercialUse
            cc:DerivativeWorks
            cc:Distribution
            cc:Notice
            cc:Reproduction
            cc:ShareAlike
            cc:Sharing
            cc:SourceCode
            ) 
    ][ 
        sh:class odrl:Action 
    ]) ;
    sh:message "Action is neither part of the ODRL Vocabulary nor typed as odrl:Action." .


:ActionWithRefinementShape a sh:NodeShape ;

    sh:property [
        sh:path rdf:value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An action refinement must have one rdf:value." ;
    ] ;

    sh:property [
        sh:severity sh:Warning ;
        sh:path rdf:value ;
        sh:node :AllowedActionValueShape ;
        sh:message "The action value should be part of the ODRL vocabulary or typed as odrl:Action." ;
    ] ;

    sh:property [
        sh:path odrl:refinement ;
        sh:minCount 1 ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "An action with refinement must have a valid refinement." ;
    ] .


#################################################
# Shape for Asset
#################################################

:AssetTypeShape a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:or (
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue odrl:Asset ;
            ]
        ]
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue odrl:AssetCollection ;
            ]
        ]
    ) ;
    sh:message "The asset should be typed as odrl:Asset or odrl:AssetCollection." .

:AssetShape a sh:NodeShape ;
    sh:node :AssetTypeShape ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An Asset may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:partOf ;
        sh:node :AssetCollectionShape ;
        sh:message "partOf should point to an AssetCollection." ;
    ] ;

    sh:property [
        sh:path odrl:hasPolicy ;
        sh:nodeKind sh:IRI ;
        sh:message "hasPolicy must point to a Policy IRI." ;
    ] .

:AssetCollectionShape a sh:NodeShape ;
    sh:node :AssetShape ;
    
    sh:property [
        sh:path odrl:source ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An AssetCollection may have one source, and it must be an IRI." ;
    ] ;
    
    sh:property [
        sh:path odrl:refinement ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each AssetCollection refinement must be a Constraint or LogicalConstraint." ;
    ] .



