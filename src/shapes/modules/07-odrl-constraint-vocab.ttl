#################################################
# Shape for Constraint Validation
#################################################

:ConstraintValidationShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:severity sh:Warning ;

    sh:node :AbsolutePositionOperatorShape ;
    sh:node :AbsoluteSpatialPositionOperatorShape ;
    sh:node :AbsoluteTemporalPositionOperatorShape ;
    sh:node :AbsoluteSizeOperatorShape ;

    sh:node :CountOperatorShape ;
    sh:node :CountRightOperandShape ;

    sh:node :DateTimeOperatorShape ;
    sh:node :DateTimeRightOperandShape .


# AbsolutePosition

:AbsolutePositionOperatorShape a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:not [
        sh:and (
            sh:property [
                sh:path odrl:leftOperand ;
                sh:hasValue odrl:absolutePosition ;
            ] 
            sh:property [
                sh:path odrl:operator ;
                sh:not [
                    sh:in (  odrl:eq odrl:gt odrl:gteq odrl:lt odrl:lteq odrl:neq ) ;
                ] ;
            ] 
        )
    ] ;
    sh:message "Absolute Position is only compatible with odrl:eq, odrl:gt, odrl:gteq, odrl:lt, odrl:lteq, or odrl:neq." .

# AbsoluteSpatialPosition

:AbsoluteSpatialPositionOperatorShape a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:not [
        sh:and (
            sh:property [
                sh:path odrl:leftOperand ;
                sh:hasValue odrl:AbsoluteSpatialPosition ;
            ] 
            sh:property [
                sh:path odrl:operator ;
                sh:not [
                    sh:in (  odrl:eq odrl:gt odrl:gteq odrl:lt odrl:lteq odrl:neq ) ;
                ] ;
            ] 
        )
    ] ;
    sh:message "Absolute Spatial Position is only compatible with odrl:eq, odrl:gt, odrl:gteq, odrl:lt, odrl:lteq, or odrl:neq." .

